        {
          "value": "20",
          "label": "20:00"
        },
        {
          "value": "21",
          "label": "21:00"
        },
        {
          "value": "22",
          "label": "22:00"
        }
      ]
    },
    {
      "key": "minFocus",
      "type": "select",
      "label": "Shortest focus block",
      "default": "30",
      "options": [
        {
          "value": "30",
          "label": "30 minutes"
        },
        {
          "value": "60",
          "label": "1 hour"
        },
        {
          "value": "90",
          "label": "1.5 hours"
        }
