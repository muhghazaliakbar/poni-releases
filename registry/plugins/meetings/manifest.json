{
  "id": "app.useponi.meetings",
  "name": "Meeting Insights",
  "version": "1.0.0",
  "author": "Poni",
  "description": "How much of today is meetings, the free blocks you still have for focused work, back-to-back warnings, this week's meeting hours by day, and a join button for the next call.",
