      "type": "select",
      "label": "Workday starts",
      "default": "9",
      "options": [
        {
          "value": "6",
          "label": "06:00"
        },
        {
          "value": "7",
          "label": "07:00"
        },
        {
          "value": "8",
          "label": "08:00"
        },
        {
