        },
        {
          "value": "11",
          "label": "11:00"
        },
        {
          "value": "12",
          "label": "12:00"
        }
      ]
    },
    {
      "key": "workEnd",
      "type": "select",
      "label": "Workday ends",
      "default": "17",
      "options": [
        {
          "value": "14",
          "label": "14:00"
        },
        {
          "value": "15",
          "label": "15:00"
        },
        {
          "value": "16",
