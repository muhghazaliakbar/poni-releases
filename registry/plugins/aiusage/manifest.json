{
  "id": "app.useponi.aiusage",
  "name": "AI Usage",
  "version": "1.1.1",
  "author": "Poni",
  "description": "Codex quota left and Claude Code token use per 5-hour block, read from local logs.",
  "category": "Developer",
  "symbol": "sparkles",
  "permissions": [
    "ai-usage"
  ],
  "refreshInterval": 10,
  "order": 23,
  "settings": [
    {
      "key": "compact",
      "type": "select",
      "label": "Beside the notch",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automatic (most recently active)"
        },
        {
          "value": "codex",
          "label": "Codex · 5-hour quota"
        },
        {
          "value": "claude",
          "label": "Claude Code · time left in block"
        },
        {
          "value": "none",
          "label": "Don’t show"
        }
      ]
    },
    {
      "key": "alert",
      "type": "number",
      "label": "Codex quota alert",
      "default": 80,
      "min": 50,
      "max": 100,
      "step": 5,
      "help": "Pop-up when 5-hour usage passes this percentage"
    }
  ],
  "locales": {
    "id": {
      "name": "Pemakaian AI",
      "description": "Sisa kuota Codex dan pemakaian token Claude Code per blok 5 jam, dibaca dari log lokal.",
      "settings": {
        "compact": {
          "label": "Di samping notch",
          "options": {
            "auto": "Otomatis (yang aktif terakhir)",
            "codex": "Codex · kuota 5 jam",
            "claude": "Claude Code · sisa waktu blok",
            "none": "Jangan tampilkan"
          }
        },
        "alert": {
          "label": "Peringatan kuota Codex",
          "help": "Pop-up saat pemakaian 5 jam melewati persentase ini"
        }
      }
    }
  }
}
