{
  "id": "app.useponi.subscriptions",
  "name": "Subscriptions",
  "version": "1.0.0",
  "author": "Poni",
  "description": "What your subscriptions cost per month and per year, which ones renew in the next two weeks, and a reminder a few days before each charge.",
  "category": "Finance",
  "pro": true,
  "symbol": "lucide:calendar-sync",
  "permissions": ["notifications"],
  "refreshInterval": 60,
  "order": 115,
  "settings": [
    {
      "key": "currency",
      "type": "select",
      "label": "Currency",
      "default": "IDR",
      "options": [
        { "value": "IDR", "label": "Indonesian rupiah (Rp)" },
        { "value": "USD", "label": "US dollar ($)" },
        { "value": "EUR", "label": "Euro (€)" },
        { "value": "GBP", "label": "British pound (£)" },
        { "value": "SGD", "label": "Singapore dollar (S$)" },
        { "value": "MYR", "label": "Malaysian ringgit (RM)" },
        { "value": "AUD", "label": "Australian dollar (A$)" },
        { "value": "JPY", "label": "Japanese yen (¥)" }
      ]
    },
    {
      "key": "remind",
      "type": "select",
      "label": "Remind me before a renewal",
      "default": "2",
      "options": [
        { "value": "0", "label": "Off" },
        { "value": "1", "label": "1 day before" },
        { "value": "2", "label": "2 days before" },
        { "value": "3", "label": "3 days before" },
        { "value": "7", "label": "A week before" }
      ]
    }
  ],
  "locales": {
    "id": {
      "name": "Langganan",
      "description": "Total biaya langganan Anda per bulan dan per tahun, mana yang diperpanjang dua minggu ke depan, dan pengingat beberapa hari sebelum tiap tagihan.",
      "category": "Keuangan",
      "settings": {
        "currency": {
          "label": "Mata uang",
          "options": {
            "IDR": "Rupiah (Rp)", "USD": "Dolar AS ($)", "EUR": "Euro (€)", "GBP": "Pound Inggris (£)",
            "SGD": "Dolar Singapura (S$)", "MYR": "Ringgit Malaysia (RM)", "AUD": "Dolar Australia (A$)", "JPY": "Yen Jepang (¥)"
          }
        },
        "remind": {
          "label": "Ingatkan sebelum perpanjangan",
          "options": { "0": "Mati", "1": "1 hari sebelumnya", "2": "2 hari sebelumnya", "3": "3 hari sebelumnya", "7": "Seminggu sebelumnya" }
        }
      }
    }
  }
